# Server Configuration
PORT=8000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your-strong-random-secret-key-change-in-production

# Firebase Authentication & Firestore (Serverless Persistence)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or inline base64 / JSON string in production:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin & 1-on-1 Course Inquiry Notifications
ADMIN_NOTIFICATION_EMAIL=waheed@quicksol.ca
ADMIN_API_KEY=admin-secret-key-change-me

# AI Assistant (DeepSeek / DeepInfra / OpenAI Compatible)
AI_API_KEY=
AI_BASE_URL=https://api.deepinfra.com/v1
AI_MODEL=deepseek-ai/DeepSeek-V4-Flash

# RevenueCat
REVENUECAT_API_KEY=
REVENUECAT_PROJECT_ID=projadcbde0e

# Upstream Islamic APIs (Defaults are pre-configured)
ALADHAN_API_BASE=https://api.aladhan.com/v1
QURAN_COM_API_BASE=https://api.quran.com/api/v4

# Support Emails
SUPPORT_EMAIL=noorsupport@googlegroups.com
